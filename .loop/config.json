{
  "gates": [
    "just test",
    "just prek"
  ],
  "plans_dir": ".loop/plans",
  "notify_title": "loop harness",
  "max_review_cycles": 3,
  "require_eval": true,
  "fingerprint_ignore": [],
  "implementation": {
    "review_passes": [
      {
        "id": "adversarial",
        "agent": "loop-implementation-reviewer",
        "enabled": true
      },
      {
        "id": "architectural",
        "agent": "loop-implementation-architect",
        "enabled": false,
        "baseline": "MANIFESTO.md"
      },
      {
        "id": "documentation",
        "agent": "loop-implementation-doc-reviewer",
        "enabled": true
      }
    ],
    "action_stages": [
      {
        "id": "update-documentation",
        "type": "agent",
        "ref": "loop-implementation-doc-writer",
        "after": "implementing",
        "enabled": false
      }
    ]
  },
  "planning": {
    "review_passes": [
      {
        "id": "plan-review",
        "agent": "loop-plan-reviewer",
        "enabled": true
      }
    ]
  }
}
